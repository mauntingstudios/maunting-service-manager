# Dev-Image fuer den Dokumente-Sidecar.
#
# Build-Kontext ist das Repository-Wurzelverzeichnis, weil das gemeinsame
# Schema-Paket unter frontend/packages/docs-schema liegt und per
# `file:../frontend/packages/docs-schema` eingebunden wird.
FROM node:22-alpine

WORKDIR /app

COPY frontend/packages/docs-schema ./frontend/packages/docs-schema
COPY docs-sidecar ./docs-sidecar

WORKDIR /app/docs-sidecar

RUN npm ci --install-links --no-audit --no-fund

ENV NODE_ENV=production
EXPOSE 8100 8101

CMD ["node", "server.mjs"]
