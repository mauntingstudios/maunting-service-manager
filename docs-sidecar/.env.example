# Hocuspocus-WebSocket (oeffentlich ueber Caddy: /api/docs/collab)
MSM_DOCS_WS_PORT=8100
MSM_DOCS_WS_ADDRESS=127.0.0.1

# Interne HTTP-API; nur Loopback, Caddy proxyt /internal/* nicht.
MSM_DOCS_HTTP_PORT=8101
MSM_DOCS_HTTP_ADDRESS=127.0.0.1

# FastAPI
MSM_BACKEND_URL=http://127.0.0.1:8000

# Muss mit dem Backend uebereinstimmen (MSM_DOCS_SIDECAR_TOKEN).
MSM_DOCS_SIDECAR_TOKEN=
# Muss mit dem Backend uebereinstimmen (MSM_DOCS_COLLAB_SECRET).
MSM_DOCS_COLLAB_SECRET=

MSM_DOCS_LOG_LEVEL=info
