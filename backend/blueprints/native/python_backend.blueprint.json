{
  "version": 1,
  "meta": {
    "id": "python_backend",
    "name": "Python Backend",
    "category": "backend",
    "author": "Maunting Studios",
    "description": "Python 3.12 API- und Backend-Server (FastAPI, Flask) mit automatischer Port-Zuordnung und PostgreSQL-Integration."
  },
  "runtime": {
    "image": "python:3.12-slim-bookworm",
    "workdir": "/data",
    "env": {
      "PORT": "{WEB_PORT}"
    },
    "startup": "./start.sh",
    "startupProfiles": [
      {
        "whenFile": "start.sh",
        "startup": "./start.sh"
      },
      {
        "whenFile": "main.py",
        "startup": "uvicorn main:app --host 0.0.0.0 --port {WEB_PORT}"
      },
      {
        "whenFile": "app.py",
        "startup": "python app.py"
      }
    ],
    "stopGracePeriodSeconds": 30,
    "startupCheckSeconds": 3.0,
    "enableExec": true
  },
  "ports": [
    {
      "name": "web",
      "protocol": "tcp"
    }
  ],
  "source": {
    "type": "dockerOnly",
    "steam": null,
    "http": null
  },
  "mods": null,
  "health": {
    "port": {
      "protocol": "tcp",
      "port": "{{WEB_PORT}}",
      "interval": "30s",
      "failure_threshold": 3
    }
  },
  "backup": null,
  "variables": [
    {
      "key": "PYTHON_ENV",
      "label": "Laufzeit-Umgebung",
      "group": "general",
      "type": "select",
      "default": "production",
      "options": [
        { "value": "production", "label": "Produktion (production)", "badge": "Empfohlen" },
        { "value": "development", "label": "Entwicklung (development)" }
      ]
    },
    {
      "key": "START_COMMAND",
      "label": "Start-Befehl",
      "description": "Optionaler Startbefehl, falls nicht main.py oder app.py verwendet wird.",
      "group": "deployment",
      "type": "string",
      "default": "",
      "placeholder": "z. B. uvicorn app.main:app"
    },
    {
      "key": "GIT_REPO_URL",
      "label": "GitHub-Repository-URL",
      "description": "Optionale öffentliche HTTPS-URL eines GitHub-Repositories.",
      "group": "deployment",
      "type": "git_url",
      "default": "",
      "placeholder": "https://github.com/benutzer/mein-python-backend"
    },
    {
      "key": "GIT_BRANCH",
      "label": "Git-Branch",
      "group": "deployment",
      "type": "string",
      "default": "main",
      "pattern": "^[A-Za-z0-9._/-]{1,128}$"
    },
    {
      "key": "APP_SECRET",
      "label": "Anwendungs-Secret",
      "description": "Optionaler API- oder Session-Schlüssel (DIS-verschlüsselt).",
      "group": "security",
      "type": "secret",
      "default": ""
    }
  ]
}
