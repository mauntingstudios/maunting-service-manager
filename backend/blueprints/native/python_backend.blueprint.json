{
  "version": 1,
  "meta": {
    "id": "python_backend",
    "name": "Python Backend",
    "category": "backend",
    "author": "Maunting Studios",
    "description": "Python 3.12 API- und Backend-Server (FastAPI, Flask) mit automatischer Port-Zuordnung und PostgreSQL-Integration."
  },
  "runtime": {
    "image": "python:3.12-slim-bookworm",
    "workdir": "/data",
    "env": {
      "PORT": "{WEB_PORT}"
    },
    "startup": "./start.sh",
    "startupProfiles": [
      {
        "whenFile": "main.py",
        "startup": "uvicorn main:app --host 0.0.0.0 --port {WEB_PORT}"
      },
      {
        "whenFile": "app.py",
        "startup": "python app.py"
      }
    ],
    "stopGracePeriodSeconds": 30,
    "startupCheckSeconds": 3.0,
    "enableExec": true
  },
  "ports": [
    {
      "name": "web",
      "protocol": "tcp"
    }
  ],
  "source": {
    "type": "dockerOnly",
    "steam": null,
    "http": null
  },
  "mods": null,
  "health": {
    "port": {
      "protocol": "tcp",
      "port": "{{WEB_PORT}}",
      "interval": "30s",
      "failure_threshold": 3
    }
  },
  "backup": null
}
