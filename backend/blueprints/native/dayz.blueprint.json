{
  "version": 1,
  "meta": {
    "id": "dayz",
    "name": "DayZ",
    "category": "steam_game",
    "author": "Maunting Studios",
    "description": "DayZ Linux Dedicated Server (App-ID 223350, Workshop 221100). Benötigt einen konfigurierten globalen Steam-Account unter Settings (Steam Guard muss deaktiviert sein; RCON per BattlEye UDP).",
    "platforms": [
      "pc",
      "ps5",
      "xbox"
    ]
  },
  "runtime": {
    "image": "ghcr.io/parkervcp/steamcmd:debian",
    "workdir": "/data",
    "user": "1000:1000",
    "env": {
      "HOME": "/data",
      "LD_LIBRARY_PATH": ".:./linux64:/usr/lib32:/usr/lib/x86_64-linux-gnu"
    },
    "startup": "./DayZServer -config=serverDZ.cfg -port={GAME_PORT} -BEpath=battleye -profiles=profiles -dologs -adminlog -netlog -freezecheck {MOD_ARG}",
    "ensureDirs": [
      "profiles",
      "battleye",
      "keys"
    ],
    "requiredFiles": [
      "DayZServer",
      "serverDZ.cfg"
    ],
    "seedFiles": [
      {
        "file": "serverDZ.cfg",
        "content": "hostname = \"DayZ Server\";\npassword = \"\";\npasswordAdmin = \"\";\nmaxPlayers = 60;\nverifySignatures = 2;\nforceSameBuild = 1;\ndisableVoN = 0;\nvonCodecQuality = 20;\ndisable3rdPerson = 0;\ndisableCrosshair = 0;\nserverTime = \"SystemTime\";\nserverTimeAcceleration = 1;\nserverNightTimeAcceleration = 1;\nserverTimePersistent = 0;\nguaranteedUpdates = 1;\nloginQueueConcurrentPlayers = 5;\nloginQueueMaxPlayers = 500;\ninstanceId = 1;\nstorageAutoFix = 1;\nsteamQueryPort = {QUERY_PORT};\n\nclass Missions\n{\n\tclass DayZ\n\t{\n\t\ttemplate = \"dayzOffline.chernarusplus\";\n\t};\n};\n"
      },
      {
        "file": "battleye/BEServer_x64.cfg",
        "content": "RConPort {RCON_PORT}\nRestrictRCon 0\n"
      }
    ],
    "configPatches": [
      {
        "type": "regex",
        "file": "serverDZ.cfg",
        "regex": "(steamQueryPort\\s*=\\s*)\\d+;",
        "value": "\\g<1>{QUERY_PORT};"
      },
      {
        "type": "regex",
        "file": "battleye/BEServer_x64.cfg",
        "regex": "(?m)^(RConPort\\s+)\\d+",
        "value": "\\g<1>{RCON_PORT}"
      }
    ]
  },
  "ports": [
    {
      "name": "game",
      "protocol": "udp"
    },
    {
      "name": "query",
      "protocol": "udp"
    },
    {
      "name": "rcon",
      "protocol": "udp"
    }
  ],
  "source": {
    "type": "steam",
    "steam": {
      "appId": "223350",
      "platform": "linux",
      "compatibility": "native",
      "requiresLogin": true,
      "branches": [
        {
          "id": "public",
          "label": "Standard (public)",
          "description": "Stabile DayZ-Release-Version fuer oeffentliche Server."
        },
        {
          "id": "experimental",
          "label": "Experimental",
          "description": "Fruehe Patch-Vorschau fuer Tests vor dem Haupt-Update."
        }
      ]
    }
  },
  "mods": {
    "supportsMods": true,
    "supportsSteamWorkshop": true,
    "workshopAppId": "221100",
    "modInjection": "startupArg",
    "modStartupArgumentFormat": "-mod={mods};",
    "modListFilePath": null,
    "modListContent": "workshopIds",
    "postInstall": [
      {
        "operation": "symlink",
        "source": "steamapps/workshop/content/{WORKSHOP_APP_ID}/{WORKSHOP_ID}",
        "target": "{WORKSHOP_ID}",
        "required": true
      },
      {
        "operation": "symlink",
        "source": "steamapps/workshop/content/{WORKSHOP_APP_ID}/{WORKSHOP_ID}/keys/*.bikey",
        "target": "keys/{BASENAME}",
        "required": false
      }
    ]
  },
  "health": {
    "process": {},
    "application": {
      "type": "source-query",
      "port": "{{QUERY_PORT}}",
      "interval": "60s",
      "failure_threshold": 3
    },
    "startup": {
      "grace_period_seconds": 120,
      "success_patterns": [
        "Dedicated host created"
      ],
      "failure_patterns": [
        "Address already in use",
        "Could not bind"
      ]
    }
  },
  "logs": {
    "sources": [
      "profiles/*.RPT",
      "profiles/*.ADM",
      "profiles/*.log",
      "stdout"
    ],
    "redact": [
      "regex:AdminPassword"
    ]
  },
  "diagnostics": {
    "parsers": [
      "linux-oom",
      "port-conflict"
    ]
  },
  "recovery": {
    "policies": [
      {
        "match": "process_not_running",
        "action": "restart"
      },
      {
        "match": "source_query_failed",
        "action": "restart"
      },
      {
        "match": "port-conflict",
        "action": "clear_declared_lock_files"
      },
      {
        "match": "linux-oom",
        "action": "graceful_restart"
      }
    ],
    "attempt_window_seconds": 600,
    "max_attempts": 3,
    "cooldown_seconds": 60
  },
  "backup": {
    "includePaths": [
      "serverDZ.cfg",
      "profiles"
    ]
  }
}
