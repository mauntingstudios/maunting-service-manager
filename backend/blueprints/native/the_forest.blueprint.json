{
  "version": 1,
  "meta": {
    "id": "the_forest",
    "name": "The Forest",
    "category": "steam_game",
    "author": "Maunting Studios",
    "description": "The Forest Dedicated Server via SteamCMD (App-ID 556450). Windows-Binary (TheForestDedicatedServer.exe) läuft über Wine + Xvfb."
  },
  "runtime": {
    "image": "ghcr.io/parkervcp/yolks:wine_10",
    "workdir": "/home/container",
    "user": "1000:1000",
    "env": {
      "WINEDEBUG": "-all",
      "WINEESYNC": "1",
      "WINEFSYNC": "1",
      "SERVER_NAME": "My Forest Server",
      "SERVER_PASSWORD": ""
    },
    "startup": "xvfb-run -a wine ./TheForestDedicatedServer.exe -batchmode -nographics -configfilepath {INSTALL_DIR}/config/config.cfg -savefolderpath {INSTALL_DIR}/saves -serverip 0.0.0.0 -servergameport {GAME_PORT} -serverqueryport {QUERY_PORT} -serversteamport {CUSTOM_PORT_1} -servername \"{SERVER_NAME}\" -logFile {INSTALL_DIR}/TheForestDedicatedServer.log",
    "ensureDirs": [
      "config",
      "saves"
    ],
    "requiredFiles": [
      "TheForestDedicatedServer.exe"
    ],
    "seedFiles": [
      {
        "file": "config/config.cfg",
        "content": "serverIP 0.0.0.0\nserverSteamPort {CUSTOM_PORT_1}\nserverGamePort {GAME_PORT}\nserverQueryPort {QUERY_PORT}\nserverName My Forest Server\nserverPlayers 8\nenableVAC off\nserverPassword\nserverPasswordAdmin adminpassword\nserverSteamAccount\ndifficulty Normal\ninitType Continue\nslot 1\nsaveFolderPath Z:\\home\\container\\saves\n"
      }
    ],
    "configPatches": [
      {
        "type": "regex",
        "file": "config/config.cfg",
        "regex": "(?m)^serverGamePort\\s+\\d+$",
        "value": "serverGamePort {GAME_PORT}"
      },
      {
        "type": "regex",
        "file": "config/config.cfg",
        "regex": "(?m)^serverQueryPort\\s+\\d+$",
        "value": "serverQueryPort {QUERY_PORT}"
      },
      {
        "type": "regex",
        "file": "config/config.cfg",
        "regex": "(?m)^serverSteamPort\\s+\\d+$",
        "value": "serverSteamPort {CUSTOM_PORT_1}"
      }
    ],
    "startupCheckSeconds": 60.0
  },
  "ports": [
    {
      "name": "game",
      "protocol": "udp"
    },
    {
      "name": "query",
      "protocol": "udp"
    },
    {
      "name": "custom",
      "protocol": "udp"
    }
  ],
  "source": {
    "type": "steam",
    "steam": {
      "appId": "556450",
      "platform": "windows",
      "compatibility": "proton",
      "requiresLogin": false,
      "validate": false
    },
    "updateStrategy": "checkBased"
  },
  "mods": {
    "supportsMods": false,
    "supportsSteamWorkshop": false,
    "workshopAppId": null,
    "modInjection": "none",
    "modStartupArgumentFormat": null,
    "modListFilePath": null,
    "modListContent": "workshopIds",
    "postInstall": []
  },
  "health": {
    "process": {},
    "application": {
      "type": "source-query",
      "port": "{{QUERY_PORT}}",
      "interval": "60s",
      "failure_threshold": 3
    },
    "startup": {
      "grace_period_seconds": 120,
      "success_patterns": [
        "Connected to Steam successfully",
        "GameServer.InitSafe success"
      ],
      "failure_patterns": [
        "Address already in use"
      ]
    }
  },
  "recovery": {
    "policies": [
      {
        "match": "process_not_running",
        "action": "restart"
      },
      {
        "match": "source_query_failed",
        "action": "restart"
      },
      {
        "match": "port-conflict",
        "action": "clear_declared_lock_files"
      },
      {
        "match": "linux-oom",
        "action": "graceful_restart"
      }
    ],
    "attempt_window_seconds": 600,
    "max_attempts": 3,
    "cooldown_seconds": 60
  },
  "backup": {
    "includePaths": [
      "Saves"
    ]
  },
  "logs": {
    "sources": [
      "TheForestDedicatedServer.log",
      "stdout"
    ],
    "redact": [
      "regex:ServerPassword",
      "regex:ServerAdminPassword"
    ]
  },
  "diagnostics": {
    "parsers": [
      "linux-oom",
      "port-conflict"
    ]
  }
}