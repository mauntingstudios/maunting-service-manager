{
  "version": 1,
  "meta": {
    "id": "project_zomboid",
    "name": "Project Zomboid",
    "category": "steam_game",
    "author": "Maunting Studios",
    "description": "Project Zomboid Dedicated Server via SteamCMD (App-ID 380870). Nativer Linux-Support.",
    "platforms": [
      "pc"
    ]
  },
  "runtime": {
    "image": "ghcr.io/parkervcp/steamcmd:debian",
    "workdir": "/data",
    "user": "1000:1000",
    "env": {
      "HOME": "/data"
    },
    "startup": "./start-server.sh -cachedir=/data -servername {SERVER_NAME} -port {GAME_PORT} -udpport {CUSTOM_PORT_1}",
    "ensureDirs": [
      "Server",
      "Logs"
    ],
    "requiredFiles": [
      "start-server.sh",
      "ProjectZomboid64",
      "ProjectZomboid64.json"
    ],
    "configPatches": [],
    "stopGracePeriodSeconds": 90,
    "startupCheckSeconds": 180.0
  },
  "ports": [
    {
      "name": "game",
      "protocol": "udp"
    },
    {
      "name": "custom",
      "protocol": "udp"
    }
  ],
  "source": {
    "type": "steam",
    "steam": {
      "appId": "380870",
      "platform": "linux",
      "compatibility": "native",
      "requiresLogin": false,
      "validate": false,
      "branches": [
        {
          "id": "public",
          "label": "Standard (public)",
          "description": "Aktueller stabiler Build fuer Langzeit-Welten."
        },
        {
          "id": "unstable",
          "label": "Unstable (Beta)",
          "description": "Testzweig fuer kommende Build-Updates."
        }
      ]
    },
    "updateStrategy": "checkBased"
  },
  "mods": {
    "supportsMods": true,
    "supportsSteamWorkshop": true,
    "workshopAppId": "108600",
    "modInjection": "file",
    "modStartupArgumentFormat": null,
    "modIdResolvers": [
      {
        "name": "zomboid_mod_info",
        "fileGlob": "steamapps/workshop/content/{WORKSHOP_APP_ID}/{WORKSHOP_ID}/mods/*/*/mod.info",
        "format": "iniKey",
        "key": "id",
        "maxMatches": 32,
        "fallback": "skip"
      }
    ],
    "modListTargets": [
      {
        "file": "Server/{SERVER_NAME}.ini",
        "key": "WorkshopItems",
        "valueSource": "workshopIds",
        "separator": ";"
      },
      {
        "file": "Server/{SERVER_NAME}.ini",
        "key": "Mods",
        "valueSource": "resolvedIds:zomboid_mod_info",
        "separator": ";"
      }
    ],
    "postInstall": []
  },
  "health": {
    "process": {},
    "startup": {
      "grace_period_seconds": 180,
      "timeout_seconds": 420,
      "success_patterns": [
        "SERVER STARTED"
      ],
      "failure_patterns": [
        "Address already in use",
        "Could not bind"
      ]
    }
  },
  "recovery": {
    "policies": [
      {
        "match": "process_not_running",
        "action": "restart"
      },
      {
        "match": "port-conflict",
        "action": "clear_declared_lock_files"
      },
      {
        "match": "linux-oom",
        "action": "graceful_restart"
      }
    ],
    "attempt_window_seconds": 600,
    "max_attempts": 3,
    "cooldown_seconds": 60
  },
  "backup": {
    "includePaths": [
      "Server",
      "Saves",
      "db"
    ]
  },
  "logs": {
    "sources": [
      "stdout",
      "server-console.txt",
      "Logs/*_DebugLog-server.txt",
      "Logs/*_user.txt",
      "Logs/*_chat.txt"
    ],
    "redact": []
  },
  "diagnostics": {
    "parsers": [
      "linux-oom",
      "port-conflict"
    ]
  },
  "players": {
    "min": 2,
    "max": 100,
    "configTarget": {
      "type": "regex",
      "file": "Server/servertest.ini",
      "regex": "MaxPlayers\\s*=\\s*\\d+",
      "replacement": "MaxPlayers={SLOTS}"
    },
    "queryProtocol": "a2s",
    "queryPortRole": "game"
  }
}
