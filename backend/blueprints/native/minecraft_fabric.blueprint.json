{
  "version": 1,
  "meta": {
    "id": "minecraft_fabric",
    "name": "Minecraft (Fabric)",
    "game": "Minecraft",
    "edition": "Fabric",
    "category": "non_steam_game",
    "author": "Maunting Studios",
    "description": "Fabric-Server via itzg/minecraft-server. Leichter, moderner Mod-Loader. Fabric-Mods (.jar) in /data/mods ablegen; werden beim Start automatisch geladen."
  },
  "runtime": {
    "image": "itzg/minecraft-server:latest",
    "workdir": "/data",
    "env": {
      "EULA": "TRUE",
      "TYPE": "FABRIC",
      "VERSION": "LATEST",
      "SERVER_PORT": "{GAME_PORT}",
      "ENABLE_QUERY": "true",
      "QUERY_PORT": "{QUERY_PORT}",
      "ENABLE_RCON": "true",
      "RCON_PORT": "{RCON_PORT}"
    },
    "startup": "/start"
  },
  "ports": [
    {
      "name": "game",
      "protocol": "tcp"
    },
    {
      "name": "query",
      "protocol": "udp"
    },
    {
      "name": "rcon",
      "protocol": "tcp"
    }
  ],
  "source": {
    "type": "dockerOnly",
    "steam": null,
    "http": null
  },
  "mods": {
    "supportsMods": true,
    "supportsSteamWorkshop": false,
    "workshopAppId": null,
    "supportsCurseForge": true,
    "curseforgeGameId": "432",
    "curseforgeClassId": "6",
    "curseforgeInstallPath": "mods",
    "modInjection": "none",
    "modStartupArgumentFormat": null,
    "modListFilePath": null
  },
  "health": {
    "process": {},
    "application": {
      "type": "minecraft-status",
      "port": "{{GAME_PORT}}",
      "interval": "60s",
      "failure_threshold": 3
    },
    "startup": {
      "grace_period_seconds": 180,
      "success_patterns": [
        "Done \\(",
        "For help, type \"help\""
      ],
      "failure_patterns": [
        "FAILED TO BIND TO PORT",
        "Perhaps a server is already running on that port?"
      ]
    }
  },
  "recovery": {
    "policies": [
      {
        "match": "process_not_running",
        "action": "restart"
      },
      {
        "match": "minecraft_status_failed",
        "action": "restart"
      },
      {
        "match": "minecraft_query_failed",
        "action": "restart"
      },
      {
        "match": "port-conflict",
        "action": "clear_declared_lock_files"
      },
      {
        "match": "linux-oom",
        "action": "graceful_restart"
      }
    ],
    "attempt_window_seconds": 600,
    "max_attempts": 3,
    "cooldown_seconds": 60
  },
  "logs": {
    "sources": [
      "logs/latest.log",
      "stdout"
    ],
    "redact": [
      "regex:rcon\\.password"
    ]
  },
  "diagnostics": {
    "parsers": [
      "linux-oom",
      "port-conflict"
    ]
  },
  "players": {
    "min": 2,
    "max": 200,
    "configTarget": {
      "type": "env",
      "key": "MAX_PLAYERS"
    },
    "queryProtocol": "minecraft_slp",
    "queryPortRole": "game"
  },
  "variables": [
    {
      "key": "VERSION",
      "label": "Minecraft-Version",
      "description": "Minecraft-Basisversion für Fabric. Muss zu deinen Mods passen.",
      "group": "version",
      "type": "select",
      "default": "LATEST",
      "allowCustom": true,
      "placeholder": "z. B. 1.21.10",
      "pattern": "^(LATEST|SNAPSHOT|[0-9]+(\\.[0-9]+){1,2}(?:-[A-Za-z0-9._-]+)?)$",
      "options": [
        { "value": "LATEST", "label": "Aktuellste Version (LATEST)", "badge": "Empfohlen" },
        { "value": "1.21.10", "label": "Minecraft 1.21.10" },
        { "value": "1.21.8", "label": "Minecraft 1.21.8" },
        { "value": "1.21.4", "label": "Minecraft 1.21.4" },
        { "value": "1.20.6", "label": "Minecraft 1.20.6" },
        { "value": "1.20.4", "label": "Minecraft 1.20.4" },
        { "value": "1.19.4", "label": "Minecraft 1.19.4" },
        { "value": "1.16.5", "label": "Minecraft 1.16.5 (Legacy)" }
      ]
    },
    {
      "key": "DIFFICULTY",
      "label": "Schwierigkeit",
      "group": "gameplay",
      "type": "select",
      "default": "normal",
      "options": [
        { "value": "peaceful", "label": "Friedlich" },
        { "value": "easy", "label": "Einfach" },
        { "value": "normal", "label": "Normal" },
        { "value": "hard", "label": "Schwer" }
      ]
    },
    {
      "key": "MODE",
      "label": "Spielmodus",
      "group": "gameplay",
      "type": "select",
      "default": "survival",
      "options": [
        { "value": "survival", "label": "Überleben" },
        { "value": "creative", "label": "Kreativ" },
        { "value": "adventure", "label": "Abenteuer" },
        { "value": "spectator", "label": "Zuschauer" }
      ]
    },
    {
      "key": "PVP",
      "label": "Spieler gegen Spieler (PvP)",
      "group": "gameplay",
      "type": "boolean",
      "default": "true"
    },
    {
      "key": "ONLINE_MODE",
      "label": "Mojang-Authentifizierung (Online-Mode)",
      "description": "Überprüft Spieler-Accounts gegen Mojang.",
      "group": "security",
      "type": "boolean",
      "default": "true"
    },
    {
      "key": "VIEW_DISTANCE",
      "label": "Sichtweite (Chunks)",
      "group": "performance",
      "type": "number",
      "default": "10",
      "min": 3,
      "max": 32
    },
    {
      "key": "MOTD",
      "label": "Server-Nachricht (MOTD)",
      "group": "general",
      "type": "string",
      "default": "Ein Maunting Fabric-Server",
      "placeholder": "Willkommen auf unserem Server"
    }
  ]
}
