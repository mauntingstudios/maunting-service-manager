{
  "version": 1,
  "meta": {
    "id": "space_engineers",
    "name": "Space Engineers",
    "category": "steam_game",
    "author": "Maunting Studios",
    "description": "Space Engineers Dedicated Server via SteamCMD (App-ID 298740). Läuft über das MSM Wine-10 + .NET 4.8 Runtime-Image. Steam Workshop (App-ID 244850).",
    "platforms": [
      "pc",
      "ps5",
      "xbox"
    ]
  },
  "runtime": {
    "image": "ghcr.io/mauntingstudios/msm-space-engineers-runtime:wine10-dotnet48",
    "workdir": "/home/container",
    "user": "1000:1000",
    "env": {
      "WINEPREFIX": "/home/container/.wine-se",
      "WINEDLLOVERRIDES": "",
      "WINEDEBUG": "-all",
      "WINEESYNC": "1",
      "WINEFSYNC": "1"
    },
    "startup": "xvfb-run -a wine ./DedicatedServer64/SpaceEngineersDedicated.exe -console -noconsole -ignorelastsession -path Z:\\\\home\\\\container\\\\config",
    "ensureDirs": [
      "config",
      "Saves"
    ],
    "requiredFiles": [
      "DedicatedServer64/SpaceEngineersDedicated.exe"
    ],
    "seedFiles": [
      {
        "file": "config/SpaceEngineers-Dedicated.cfg",
        "content": "<?xml version=\"1.0\"?>\n<MyConfigDedicated xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\">\n  <SessionSettings>\n    <GameMode>Survival</GameMode>\n    <MaxPlayers>16</MaxPlayers>\n    <OnlineMode>PUBLIC</OnlineMode>\n    <AutoSaveInMinutes>5</AutoSaveInMinutes>\n  </SessionSettings>\n  <ServerName>My Space Engineers Server</ServerName>\n  <WorldName>MSMWorld</WorldName>\n  <IP>0.0.0.0</IP>\n  <ServerPort>{GAME_PORT}</ServerPort>\n  <SteamPort>{QUERY_PORT}</SteamPort>\n  <LoadWorld>Z:\\home\\container\\Saves\\MSMWorld</LoadWorld>\n</MyConfigDedicated>\n"
      }
    ],
    "configPatches": [
      {
        "type": "regex",
        "file": "config/SpaceEngineers-Dedicated.cfg",
        "regex": "(<ServerPort>)\\d+(</ServerPort>)",
        "value": "\\g<1>{GAME_PORT}\\g<2>"
      },
      {
        "type": "regex",
        "file": "config/SpaceEngineers-Dedicated.cfg",
        "regex": "(<SteamPort>)\\d+(</SteamPort>)",
        "value": "\\g<1>{QUERY_PORT}\\g<2>"
      }
    ],
    "startupCheckSeconds": 120.0
  },
  "ports": [
    {
      "name": "game",
      "protocol": "udp"
    },
    {
      "name": "query",
      "protocol": "udp"
    }
  ],
  "source": {
    "type": "steam",
    "steam": {
      "appId": "298740",
      "platform": "windows",
      "compatibility": "proton",
      "requiresLogin": false,
      "validate": false
    },
    "updateStrategy": "checkBased"
  },
  "mods": {
    "supportsMods": true,
    "supportsSteamWorkshop": true,
    "workshopAppId": "244850",
    "filterTags": [],
    "modInjection": "file",
    "modStartupArgumentFormat": null,
    "modListFilePath": "config/modlist.txt",
    "modListContent": "workshopIds",
    "postInstall": []
  },
  "health": {
    "process": {},
    "port": {
      "protocol": "udp",
      "port": "{{SERVER_PORT}}",
      "interval": "60s",
      "failure_threshold": 3
    },
    "startup": {
      "grace_period_seconds": 120,
      "success_patterns": [
        "Game ready",
        "Press Ctrl+C to exit"
      ],
      "failure_patterns": [
        "Address already in use"
      ]
    }
  },
  "recovery": {
    "policies": [
      {
        "match": "process_not_running",
        "action": "restart"
      },
      {
        "match": "port-conflict",
        "action": "clear_declared_lock_files"
      },
      {
        "match": "linux-oom",
        "action": "graceful_restart"
      }
    ],
    "attempt_window_seconds": 600,
    "max_attempts": 3,
    "cooldown_seconds": 60
  },
  "backup": {
    "includePaths": [
      "config",
      "Saves"
    ]
  },
  "logs": {
    "sources": [
      "stdout",
      "config/SpaceEngineersDedicated*.log",
      "SpaceEngineersDedicated.log"
    ],
    "redact": [
      "regex:ServerPassword"
    ]
  },
  "diagnostics": {
    "parsers": [
      "linux-oom",
      "port-conflict"
    ]
  }
}
