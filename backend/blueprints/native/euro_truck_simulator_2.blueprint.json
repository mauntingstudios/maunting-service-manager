{
  "version": 1,
  "meta": {
    "id": "euro_truck_simulator_2",
    "name": "Euro Truck Simulator 2 (ETS2)",
    "category": "steam_game",
    "author": "Maunting Studios",
    "description": "Euro Truck Simulator 2 Dedicated Server via SteamCMD (App-ID 1948160). Nativer Linux-Support. Wichtig: Exportiere im Spiel per Konsole 'export_server_packages' und lade server_packages.dat + server_packages.sii in .local/share/Euro Truck Simulator 2/ hoch.",
    "platforms": [
      "pc"
    ]
  },
  "runtime": {
    "image": "ghcr.io/parkervcp/steamcmd:debian",
    "workdir": "/data",
    "user": "1000:1000",
    "env": {
      "HOME": "/data",
      "LD_LIBRARY_PATH": ".:./linux64:/usr/lib32:/usr/lib/x86_64-linux-gnu"
    },
    "startup": "./bin/linux_x64/eurotrucks2_server -nosingle",
    "ensureDirs": [
      ".local/share/Euro Truck Simulator 2"
    ],
    "requiredFiles": [
      "bin/linux_x64/eurotrucks2_server"
    ],
    "seedFiles": [
      {
        "file": ".local/share/Euro Truck Simulator 2/server_config.sii",
        "content": "SiiNunit\n{\nserver_config : _nameless.config {\n lobby_name: \"My MSM ETS2 Server\"\n description: \"\"\n welcome_message: \"\"\n password: \"\"\n max_players: 8\n max_vehicles_total: 100\n max_ai_vehicles_player: 50\n max_ai_vehicles_player_spawn: 50\n connection_virtual_port: 100\n query_virtual_port: 101\n connection_dedicated_port: {GAME_PORT}\n query_dedicated_port: {QUERY_PORT}\n server_logon_token: \"\"\n player_damage: true\n traffic: true\n hide_in_company: false\n hide_colliding: true\n force_speed_limiter: false\n mods_optioning: false\n timezones: 0\n service_no_collision: false\n in_menu_ghosting: false\n name_tags: true\n friends_only: false\n show_server: true\n moderator_list: 0\n}\n}\n"
      }
    ],
    "configPatches": [
      {
        "type": "regex",
        "file": ".local/share/Euro Truck Simulator 2/server_config.sii",
        "regex": "(connection_dedicated_port\\s*:\\s*)\\d+",
        "value": "\\g<1>{GAME_PORT}"
      },
      {
        "type": "regex",
        "file": ".local/share/Euro Truck Simulator 2/server_config.sii",
        "regex": "(query_dedicated_port\\s*:\\s*)\\d+",
        "value": "\\g<1>{QUERY_PORT}"
      }
    ],
    "startupCheckSeconds": 60.0
  },
  "ports": [
    {
      "name": "game",
      "protocol": "udp"
    },
    {
      "name": "game",
      "protocol": "tcp"
    },
    {
      "name": "query",
      "protocol": "udp"
    },
    {
      "name": "query",
      "protocol": "tcp"
    }
  ],
  "source": {
    "type": "steam",
    "steam": {
      "appId": "1948160",
      "artworkAppId": "227300",
      "platform": "linux",
      "compatibility": "native",
      "requiresLogin": false,
      "validate": false
    },
    "updateStrategy": "checkBased"
  },
  "mods": {
    "supportsMods": false,
    "supportsSteamWorkshop": false,
    "workshopAppId": null,
    "modInjection": "none",
    "modStartupArgumentFormat": null,
    "modListFilePath": null,
    "modListContent": "workshopIds",
    "postInstall": []
  },
  "health": {
    "process": {},
    "application": {
      "type": "source-query",
      "port": "{{QUERY_PORT}}",
      "interval": "60s",
      "failure_threshold": 3
    },
    "startup": {
      "grace_period_seconds": 60,
      "success_patterns": [
        "Server has been started",
        "session successfully created"
      ],
      "failure_patterns": [
        "Address already in use",
        "Could not bind"
      ]
    }
  },
  "logs": {
    "sources": [
      ".local/share/Euro Truck Simulator 2/server.log.txt",
      "stdout"
    ],
    "redact": [
      "regex:password"
    ]
  },
  "diagnostics": {
    "parsers": [
      "linux-oom",
      "port-conflict"
    ]
  },
  "recovery": {
    "policies": [
      {
        "match": "process_not_running",
        "action": "restart"
      },
      {
        "match": "source_query_failed",
        "action": "restart"
      },
      {
        "match": "port-conflict",
        "action": "clear_declared_lock_files"
      },
      {
        "match": "linux-oom",
        "action": "graceful_restart"
      }
    ],
    "attempt_window_seconds": 600,
    "max_attempts": 3,
    "cooldown_seconds": 60
  },
  "backup": {
    "includePaths": [
      ".local/share/Euro Truck Simulator 2/server_config.sii",
      ".local/share/Euro Truck Simulator 2/profiles"
    ]
  }
}
