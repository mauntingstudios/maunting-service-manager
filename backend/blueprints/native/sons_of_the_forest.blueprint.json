{
  "version": 1,
  "meta": {
    "id": "sons_of_the_forest",
    "name": "Sons of the Forest",
    "category": "steam_game",
    "author": "Maunting Studios",
    "description": "Sons of the Forest Dedicated Server via SteamCMD (App-ID 2465200). Windows-Binary (SonsOfTheForestDS.exe) läuft über Wine + Xvfb."
  },
  "runtime": {
    "image": "ghcr.io/parkervcp/yolks:wine_10",
    "workdir": "/home/container",
    "user": "1000:1000",
    "env": {
      "WINEDEBUG": "-all",
      "WINEESYNC": "1",
      "WINEFSYNC": "1"
    },
    "startup": "xvfb-run -a wine ./SonsOfTheForestDS.exe -userdatapath {INSTALL_DIR}/userdata -dedicatedserver.IpAddress 0.0.0.0 -dedicatedserver.GamePort {GAME_PORT} -dedicatedserver.QueryPort {QUERY_PORT} -dedicatedserver.BlobSyncPort {CUSTOM_PORT_1} -logFile {INSTALL_DIR}/userdata/logs/SonsOfTheForestDS.log",
    "ensureDirs": [
      "userdata",
      "userdata/logs"
    ],
    "requiredFiles": [
      "SonsOfTheForestDS.exe"
    ],
    "seedFiles": [
      {
        "file": "userdata/dedicatedserver.cfg",
        "content": "{\n  \"IpAddress\": \"0.0.0.0\",\n  \"GamePort\": {GAME_PORT},\n  \"QueryPort\": {QUERY_PORT},\n  \"BlobSyncPort\": {CUSTOM_PORT_1},\n  \"ServerName\": \"My Sons Of The Forest Server\",\n  \"MaxPlayers\": 8,\n  \"Password\": \"\",\n  \"LanOnly\": false,\n  \"SaveSlot\": 1,\n  \"SaveMode\": \"Continue\",\n  \"GameMode\": \"Normal\",\n  \"SaveInterval\": 600\n}\n"
      }
    ],
    "configPatches": [
      {
        "type": "regex",
        "file": "userdata/dedicatedserver.cfg",
        "regex": "(\"GamePort\"\\s*:\\s*)\\d+",
        "value": "\\g<1>{GAME_PORT}"
      },
      {
        "type": "regex",
        "file": "userdata/dedicatedserver.cfg",
        "regex": "(\"QueryPort\"\\s*:\\s*)\\d+",
        "value": "\\g<1>{QUERY_PORT}"
      },
      {
        "type": "regex",
        "file": "userdata/dedicatedserver.cfg",
        "regex": "(\"BlobSyncPort\"\\s*:\\s*)\\d+",
        "value": "\\g<1>{CUSTOM_PORT_1}"
      }
    ],
    "startupCheckSeconds": 90.0
  },
  "ports": [
    {
      "name": "game",
      "protocol": "udp"
    },
    {
      "name": "query",
      "protocol": "udp"
    },
    {
      "name": "custom",
      "protocol": "udp"
    }
  ],
  "source": {
    "type": "steam",
    "steam": {
      "appId": "2465200",
      "artworkAppId": "1326470",
      "platform": "windows",
      "compatibility": "proton",
      "requiresLogin": false,
      "validate": false
    },
    "updateStrategy": "checkBased"
  },
  "mods": {
    "supportsMods": false,
    "supportsSteamWorkshop": false,
    "workshopAppId": null,
    "modInjection": "none",
    "modStartupArgumentFormat": null,
    "modListFilePath": null,
    "modListContent": "workshopIds",
    "postInstall": []
  },
  "health": {
    "process": {},
    "application": {
      "type": "source-query",
      "port": "{{QUERY_PORT}}",
      "interval": "60s",
      "failure_threshold": 3
    },
    "startup": {
      "grace_period_seconds": 120,
      "success_patterns": [
        "GameServer Started"
      ],
      "failure_patterns": [
        "Address already in use"
      ]
    }
  },
  "recovery": {
    "policies": [
      {
        "match": "process_not_running",
        "action": "restart"
      },
      {
        "match": "source_query_failed",
        "action": "restart"
      },
      {
        "match": "port-conflict",
        "action": "clear_declared_lock_files"
      },
      {
        "match": "linux-oom",
        "action": "graceful_restart"
      }
    ],
    "attempt_window_seconds": 600,
    "max_attempts": 3,
    "cooldown_seconds": 60
  },
  "backup": {
    "includePaths": [
      "userdata"
    ]
  },
  "logs": {
    "sources": [
      "stdout",
      "userdata/logs/SonsOfTheForestDS.log",
      "userdata/logs/*.txt"
    ],
    "redact": [
      "regex:ServerPassword",
      "regex:ServerAdminPassword"
    ]
  },
  "diagnostics": {
    "parsers": [
      "linux-oom",
      "port-conflict"
    ]
  }
}