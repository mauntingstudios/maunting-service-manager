{
  "version": 1,
  "meta": {
    "id": "abiotic_factor",
    "name": "Abiotic Factor",
    "category": "steam_game",
    "author": "Maunting Studios",
    "description": "Abiotic Factor Dedicated Server (Steam App-ID 2857200). Läuft zuverlässig über GE-Proton + UMU (msm-proton-runtime) mit Source-Query.",
    "platforms": [
      "pc"
    ]
  },
  "runtime": {
    "image": "ghcr.io/mauntingstudios/msm-proton-runtime:ge-proton10-34-umu1.4.0",
    "workdir": "/home/container",
    "user": "1000:1000",
    "env": {
      "GAMEID": "umu-2857200",
      "WINEPREFIX": "/home/container/.proton-prefix",
      "NUM_PLAYERS": "6"
    },
    "startup": "xvfb-run -a /opt/umu-launcher/umu-run ./AbioticFactor/Binaries/Win64/AbioticFactorServer-Win64-Shipping.exe -log -useperfthreads -NoAsyncLoadingThread -MaxServerPlayers={ENV.NUM_PLAYERS} -Port={GAME_PORT} -QueryPort={QUERY_PORT} -SteamServerName=\"{SERVER_NAME}\"",
    "ensureDirs": [
      ".local/share/umu",
      "AbioticFactor/Saved/Logs",
      "AbioticFactor/Saved/SaveGames/Server",
      "AbioticFactor/Saved/Config/WindowsServer"
    ],
    "requiredFiles": [
      "AbioticFactor/Binaries/Win64/AbioticFactorServer-Win64-Shipping.exe"
    ],
    "configPatches": [],
    "stopGracePeriodSeconds": 60,
    "startupCheckSeconds": 90.0,
    "allowUnprivilegedUserNamespaces": true
  },
  "ports": [
    {
      "name": "game",
      "protocol": "udp"
    },
    {
      "name": "query",
      "protocol": "udp"
    }
  ],
  "source": {
    "type": "steam",
    "steam": {
      "appId": "2857200",
      "artworkAppId": "427410",
      "platform": "windows",
      "compatibility": "proton",
      "requiresLogin": false,
      "validate": false
    },
    "updateStrategy": "checkBased"
  },
  "mods": {
    "supportsMods": false,
    "supportsSteamWorkshop": false,
    "workshopAppId": null,
    "modInjection": "none",
    "modStartupArgumentFormat": null,
    "modListFilePath": null,
    "modListContent": "workshopIds",
    "postInstall": []
  },
  "health": {
    "process": {},
    "application": {
      "type": "source-query",
      "port": "{{QUERY_PORT}}",
      "interval": "60s",
      "failure_threshold": 3
    },
    "startup": {
      "grace_period_seconds": 120,
      "success_patterns": [
        "LogInit: Display: Engine is initialized."
      ],
      "failure_patterns": [
        "Address already in use",
        "Could not bind"
      ]
    }
  },
  "logs": {
    "sources": [
      "stdout",
      "AbioticFactor/Saved/Logs/AbioticFactor.log"
    ],
    "redact": [
      "regex:ServerPassword"
    ]
  },
  "diagnostics": {
    "parsers": [
      "linux-oom",
      "port-conflict"
    ]
  },
  "recovery": {
    "policies": [
      {
        "match": "process_not_running",
        "action": "restart"
      },
      {
        "match": "source_query_failed",
        "action": "restart"
      },
      {
        "match": "port-conflict",
        "action": "clear_declared_lock_files"
      },
      {
        "match": "linux-oom",
        "action": "graceful_restart"
      }
    ],
    "attempt_window_seconds": 600,
    "max_attempts": 3,
    "cooldown_seconds": 60
  },
  "backup": {
    "includePaths": [
      "AbioticFactor/Saved/SaveGames",
      "AbioticFactor/Saved/Config"
    ]
  }
}
