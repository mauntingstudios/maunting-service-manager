{
  "version": 1,
  "meta": {
    "id": "web_static",
    "name": "Statisches Web-Frontend",
    "category": "frontend",
    "author": "Maunting Studios",
    "description": "Statisches Web-Frontend (React, Vue, Vite, HTML/JS) im isolierten Caddy-Container mit SPA-Fallback für Client-seitiges Routing."
  },
  "runtime": {
    "image": "caddy:2-alpine",
    "workdir": "/data",
    "env": {},
    "startup": "caddy run --config /data/Caddyfile --adapter caddyfile",
    "seedFiles": [
      {
        "file": "index.html",
        "content": "<!doctype html>\n<html lang=\"de\">\n<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>MSM Web-Frontend</title></head>\n<body style=\"font-family:system-ui,sans-serif;padding:2rem\"><h1>Frontend bereit</h1><p>Lade deine gebauten Dateien (z. B. den Inhalt von <code>dist/</code>) über den Datei-Tab hoch.</p></body>\n</html>\n"
      }
    ],
    "stopGracePeriodSeconds": 10,
    "startupCheckSeconds": 2.0
  },
  "ports": [
    {
      "name": "web",
      "protocol": "tcp"
    }
  ],
  "source": {
    "type": "dockerOnly",
    "steam": null,
    "http": null
  },
  "frontend": {
    "spaFallback": true,
    "previewsAllowed": false,
    "maxPreviews": 0,
    "env": {}
  },
  "mods": null,
  "health": {
    "port": {
      "protocol": "tcp",
      "port": "{{WEB_PORT}}",
      "interval": "30s",
      "failure_threshold": 3
    }
  },
  "backup": {
    "includePaths": [
      "index.html",
      "assets"
    ]
  },
  "variables": [
    {
      "key": "SITE_TITLE",
      "label": "Seitentitel",
      "group": "general",
      "type": "string",
      "default": "Meine Website",
      "placeholder": "Meine App"
    },
    {
      "key": "CACHE_CONTROL",
      "label": "Cache-Richtlinie",
      "description": "Cache-Header für statische Assets.",
      "group": "performance",
      "type": "select",
      "default": "public, max-age=3600",
      "options": [
        { "value": "public, max-age=3600", "label": "1 Stunde (Standard)" },
        { "value": "public, max-age=86400", "label": "24 Stunden" },
        { "value": "no-cache", "label": "Kein Cache (no-cache)" }
      ]
    },
    {
      "key": "SPA_FALLBACK",
      "label": "Single-Page-App-Routing (SPA-Fallback)",
      "description": "Leitet unbekannte Pfade für React-/Vue-Router auf index.html weiter.",
      "group": "general",
      "type": "boolean",
      "default": "true"
    }
  ]
}
