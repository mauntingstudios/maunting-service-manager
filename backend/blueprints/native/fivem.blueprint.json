{
  "version": 1,
  "meta": {
    "id": "fivem",
    "name": "FiveM / RedM (FXServer)",
    "category": "non_steam_game",
    "author": "Maunting Studios",
    "description": "FiveM und RedM Multiplayer-Server (Cfx.re FXServer Build 38435) über das gepinnte MSM-Runtime-Image. Trage deinen kostenlosen Keymaster-Lizenzschlüssel (portal.cfx.re) als sv_licenseKey in server.cfg ein."
  },
  "runtime": {
    "image": "ghcr.io/mauntingstudios/msm-fivem-runtime:build-38435",
    "workdir": "/home/container",
    "user": "1000:1000",
    "env": {
      "HOME": "/home/container",
      "TXHOST_DATA_PATH": "/home/container/txData",
      "TAGS": "msm",
      "PROJECT_NAME": "My MSM FXServer",
      "PROJECT_DESC": "FiveM server powered by Maunting Service Manager"
    },
    "startup": "/usr/local/bin/msm-fivem-server +exec server.cfg +set tags {ENV.TAGS} +set sv_projectName {ENV.PROJECT_NAME} +set sv_projectDesc {ENV.PROJECT_DESC}",
    "ensureDirs": [
      "resources",
      "txData"
    ],
    "requiredFiles": [
      "server.cfg"
    ],
    "seedFiles": [
      {
        "file": "server.cfg",
        "content": "endpoint_add_tcp \"0.0.0.0:{GAME_PORT}\"\nendpoint_add_udp \"0.0.0.0:{GAME_PORT}\"\n\nsv_maxclients 48\nsv_hostname \"My MSM FXServer\"\nsets locale \"de-DE\"\n\n# Set your Cfx.re license key from https://portal.cfx.re/\nsv_licenseKey \"changeme\"\nset steam_webApiKey \"\"\n\nensure mapmanager\nensure chat\nensure spawnmanager\nensure sessionmanager\nensure basic-gamemode\nensure hardcap\n"
      }
    ],
    "configPatches": [
      {
        "type": "regex",
        "file": "server.cfg",
        "regex": "(endpoint_add_tcp\\s*\"0\\.0\\.0\\.0:)\\d+(\")",
        "value": "\\g<1>{GAME_PORT}\\g<2>"
      },
      {
        "type": "regex",
        "file": "server.cfg",
        "regex": "(endpoint_add_udp\\s*\"0\\.0\\.0\\.0:)\\d+(\")",
        "value": "\\g<1>{GAME_PORT}\\g<2>"
      }
    ],
    "startupCheckSeconds": 45.0
  },
  "ports": [
    {
      "name": "game",
      "protocol": "tcp"
    },
    {
      "name": "game",
      "protocol": "udp"
    }
  ],
  "source": {
    "type": "dockerOnly",
    "steam": null,
    "http": null
  },
  "mods": {
    "supportsMods": false,
    "supportsSteamWorkshop": false,
    "workshopAppId": null,
    "modInjection": "none",
    "modStartupArgumentFormat": null,
    "modListFilePath": null,
    "modListContent": "workshopIds",
    "postInstall": []
  },
  "health": {
    "process": {},
    "application": {
      "type": "http-ping",
      "port": "{{PORT:game}}",
      "path": "/info.json",
      "interval": "60s",
      "failure_threshold": 3
    },
    "startup": {
      "grace_period_seconds": 45,
      "success_patterns": [
        "Authenticating with master",
        "Sending heartbeat"
      ],
      "failure_patterns": [
        "Address already in use",
        "Could not bind"
      ]
    }
  },
  "logs": {
    "sources": [
      "stdout"
    ],
    "redact": [
      "regex:sv_licenseKey"
    ]
  },
  "diagnostics": {
    "parsers": [
      "linux-oom",
      "port-conflict"
    ]
  },
  "recovery": {
    "policies": [
      {
        "match": "process_not_running",
        "action": "restart"
      },
      {
        "match": "http_request_failed",
        "action": "restart"
      },
      {
        "match": "http_unexpected_status",
        "action": "restart"
      },
      {
        "match": "port-conflict",
        "action": "clear_declared_lock_files"
      },
      {
        "match": "linux-oom",
        "action": "graceful_restart"
      }
    ],
    "attempt_window_seconds": 600,
    "max_attempts": 3,
    "cooldown_seconds": 60
  },
  "backup": {
    "includePaths": [
      "server.cfg",
      "resources"
    ]
  }
}
