{
  "name": "@maunting/ui",
  "version": "2.0.0",
  "private": true,
  "description": "MauntingStudios design system: tokens, primitives and navigation for the MSM ecosystem.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 -c .storybook",
    "storybook:build": "storybook build -c .storybook -o storybook-static"
  },
  "sideEffects": ["./src/tokens.css", "./src/styles.css"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./swarm": {
      "types": "./src/swarm/index.d.ts",
      "default": "./src/swarm/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./styles.css": "./src/styles.css"
  },
  "peerDependencies": {
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-i18next": "^14.0.0 || ^15.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "files": ["src", "README.md"],
  "devDependencies": {
    "@storybook/react-vite": "^10.6.5",
    "storybook": "^10.6.5"
  }
}
